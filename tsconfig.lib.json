{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["lib/**/*"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",

    "module": "preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,

    "lib": ["ES2023"],
    "types": [],

    "allowJs": true,
    "checkJs": false
  }
}
