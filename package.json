{
  "name": "vue-ts-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "hello": "tsx --tsconfig tsconfig.scripts.json scripts/hello.ts"
  },
  "dependencies": {
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@tsconfig/node24": "^24.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vue-tsc": "^3.0.4"
  }
}
